# Benchmarking against the hosted Jev API.
TYPESAFE_API_KEY=

# The LLM baseline `levbench compare` measures against.
ANTHROPIC_API_KEY=

# Only if you front a local /v1/systemone server with auth. Your real
# TYPESAFE_API_KEY is deliberately never sent to a --base-url host.
# Left commented on purpose: `VAR=` sets the variable to the empty string,
# which is not the same as leaving it unset.
# LEVBENCH_LOCAL_API_KEY=
